# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Comma-separated guild IDs for fast dev command registration (leave empty for global registration)
DISCORD_DEV_GUILD_IDS=

# Anthropic (Claude Haiku — used for BOTH cheap ambient pre-check gate and full response generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Deepgram (primary streaming STT)
DEEPGRAM_API_KEY=

# ElevenLabs (streaming TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Storage (PostgreSQL connection string — user_profiles/guild_settings/conversation_log/usage_log)
# For docker-compose, host is the "postgres" service name, not localhost.
DATABASE_URL=postgres://receipts_bot:receipts_bot@localhost:5432/receipts_bot

# Behavior defaults (per-guild overrides live in guild_settings table)
DEFAULT_MODE=active
DEFAULT_MAX_RESPONSES_PER_MINUTE=8
DEFAULT_MIN_GAP_SECONDS=6
DEFAULT_STT_CONFIDENCE_THRESHOLD=0.6
DEFAULT_ALLOW_AMBIENT_BARGE_IN=false
# Auto-join a voice channel when a (non-bot) user enters it, without needing /join. Process-wide only in v1 (no per-guild override yet).
DEFAULT_AUTO_JOIN_ON_USER_ENTRY=false
# Minimum seconds between timer-driven proactive chime-in attempts per guild (brief: "~once per 2 minutes").
DEFAULT_PROACTIVE_CHIME_INTERVAL_SECONDS=120
# Master on/off switch for proactive chime-in, independent of the cadence above.
DEFAULT_PROACTIVE_CHIME_ENABLED=true

# In-process Express admin/health HTTP server (src/http/server.ts)
HTTP_PORT=3000
# Shared-secret bearer token required on every /admin/* request
# (Authorization: Bearer <token>). Required, min 32 chars. Generate a real
# random value per deployment, e.g.: openssl rand -hex 32
# Do NOT reuse this comment or any example-looking string as the real value.
ADMIN_API_TOKEN=

# Logging
LOG_LEVEL=info
