{
  "name": "receipts-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord AI voice companion bot (Neuro-Sama-style ambient co-host). Repo name is legacy/unrelated to receipts.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
