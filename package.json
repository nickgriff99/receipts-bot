    "cli:test": "tsx src/cli/testMode.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@deepgram/sdk": "^5.7.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@elevenlabs/elevenlabs-js": "^2.59.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "prism-media": "^1.3.5",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
